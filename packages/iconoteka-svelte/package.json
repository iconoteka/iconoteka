{
  "name": "iconoteka-svelte",
  "version": "0.3.1",
  "description": "Iconoteka icons as Svelte components — 1300 icons, 7 weights, stroke and fill",
  "license": "MIT",
  "author": "turbaba",
  "homepage": "https://iconoteka.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iconoteka/iconoteka.git",
    "directory": "packages/iconoteka-svelte"
  },
